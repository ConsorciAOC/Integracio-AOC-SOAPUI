<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DatosEspecificos">
		<xs:complexType>
			<xs:choice>
				<xs:element ref="Consulta"/>
				<xs:element ref="Retorno"/>
			</xs:choice>
			<xs:attribute name="Id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Consulta">
		<xs:complexType>
			<xs:all>
				<xs:element name="Matricula" type="Matricula"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Retorno">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Estado"/>
				<xs:element ref="Consulta"/>
				<xs:element ref="DatosVehiculo" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="Matricula">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="9"/>
			<xs:whiteSpace value="collapse"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Estado">
		<xs:complexType>
			<xs:all>
				<xs:element name="CodigoEstado">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="4"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CodigoEstadoSecundario" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Literal">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="1024"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<!-- Datos vehículo -->
	<xs:element name="DatosVehiculo">
		<xs:complexType>
			<xs:all>
				<xs:element ref="DatosGenerales"/>
				<xs:element ref="DatosTecnicos" minOccurs="0"/>
				<xs:element ref="Seguro" minOccurs="0"/>
				<xs:element ref="Baja" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="DatosGenerales">
		<xs:complexType>
			<xs:all>
				<xs:element ref="DescripcionVehiculo" minOccurs="0"/>
				<xs:element ref="Matriculacion"/>
				<xs:element name="FechaCaducidadITV" type="Fecha" minOccurs="0"/>
				<xs:element ref="Indicadores" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Matriculacion">
		<xs:annotation>
			<xs:documentation>Datos  matriculación del vehículo</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="Matricula" type="Matricula"/>
				<xs:element name="FechaMatriculacion" type="Fecha" minOccurs="0"/>
				<xs:element name="FechaPrimeraMatriculacion" type="Fecha" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Indicadores">
		<xs:annotation>
			<xs:documentation>Indicadores</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Precinto"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Precinto">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="S"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DescripcionVehiculo">
		<xs:annotation>
			<xs:documentation>Descripción del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Bastidor" minOccurs="0"/>
				<xs:element ref="Marca" minOccurs="0"/>
				<xs:element ref="Modelo" minOccurs="0"/>
				<xs:element ref="Servicio" minOccurs="0"/>
				<xs:element ref="TipoIndustria" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Bastidor">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="collapse"/>
				<xs:minLength value="1"/>
				<xs:maxLength value="25"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Marca">
		<xs:annotation>
			<xs:documentation>Marca del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Código de la marca del vehículo consultado</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Descripcion" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Marca del vehículo consultado</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Codigo">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="5"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Descripcion">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="255"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Modelo">
		<xs:annotation>
			<xs:documentation>Modelo del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="50"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Servicio">
		<xs:annotation>
			<xs:documentation>Servicio al que está destinado el vehículo</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Código del servicio al que está destinado el vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Descripcion" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Servicio al que está destinado el vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="TipoIndustria">
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Código del tipo de industria del vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Descripcion" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Tipo de industria del vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="DatosTecnicos">
		<xs:annotation>
			<xs:documentation>Datos técnicos del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Plazas" minOccurs="0"/>
				<xs:element ref="Masas" minOccurs="0"/>
				<xs:element ref="Propulsion" minOccurs="0"/>
				<xs:element ref="NivelEmisiones" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="NivelEmisiones">
		<xs:annotation>
			<xs:documentation>Nivel de emisiones del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="10"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Plazas">
		<xs:annotation>
			<xs:documentation>Plazas del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Normales" minOccurs="0"/>
				<xs:element ref="Mixtas" minOccurs="0"/>
				<xs:element ref="DePie" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Masas">
		<xs:annotation>
			<xs:documentation>Datos de las masas del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="Tara" type="Masa" minOccurs="0"/>
				<xs:element name="MasaMaxima" type="Masa" minOccurs="0"/>
				<xs:element name="MasaMaximaTecnica" type="Masa" minOccurs="0"/>
				<xs:element name="MasaServicio" type="Masa" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Propulsion">
		<xs:annotation>
			<xs:documentation>Datos de la propulsión del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Código del tipo de propulsión vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Descripcion" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Propulsión de vehículo</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	

<xs:element name="Seguro">
<xs:complexType>
		<xs:all>
			<xs:element name="FechaInicio" type="Fecha" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha de inicio del seguro del vehículo conusltado</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FechaFin" type="Fecha" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha de fin del seguro del vehículo conusltado</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		</xs:complexType>
	</xs:element>	
	
	<xs:element name="Baja">
<xs:complexType>
		<xs:all>
			<xs:element name="FechaInicio" type="Fecha" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha de inicio de la baja del vehículo consultado</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FechaFin" type="Fecha" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha de fin de la baja del vehículo consultado</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		</xs:complexType>
	</xs:element>	
	
	<xs:element name="Mixtas">
		<xs:annotation>
			<xs:documentation>Número de plazas mixtas del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="7"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Normales">
		<xs:annotation>
			<xs:documentation>Número de plazas normales del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:int">
				<xs:minInclusive value="0"/>
				<xs:maxInclusive value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DePie">
		<xs:annotation>
			<xs:documentation>Número de plazas de pie del vehículo consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:int">
				<xs:minInclusive value="0"/>
				<xs:maxInclusive value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:simpleType name="Masa">
		<xs:restriction base="xs:int"/>
	</xs:simpleType>
	<xs:simpleType name="Fecha">
		<xs:restriction base="xs:date"/>
	</xs:simpleType>
</xs:schema>
